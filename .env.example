# ─────────────────────────────────────────────
#  ABUELA — Environment Variables
# ─────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in real values.
#  Never commit `.env.local` — it is already in .gitignore.
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
# Primary connection string used by Prisma and the app.
# Prisma config reads POSTGRES_PRISMA_URL; the app falls back to DATABASE_URL.
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/abuela?schema=public"
# DATABASE_URL="postgresql://user:password@localhost:5432/abuela?schema=public"

# ── NextAuth.js (Auth.js v5) ──────────────────
# Generate a secret:  npx auth secret   OR   openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Base URL of your app (used internally by NextAuth for callbacks).
# Set this in production; not strictly required in local dev.
# NEXTAUTH_URL="http://localhost:3000"

# ── Cloudinary (optional — image uploads) ─────
# Only needed if you enable image upload to Cloudinary.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
